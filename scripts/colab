#!/usr/bin/env bash
# Wrapper around the Colab CLI for this repo.
#
# Two things it fixes so they don't have to be remembered every time:
#
#   SSL_CERT_FILE  the python.org build of Python this venv uses ships no CA
#                  bundle, so the CLI's urllib calls fail with
#                  CERTIFICATE_VERIFY_FAILED. Point it at certifi.
#   --auth=adc     Application Default Credentials, which is the headless
#                  path. The oauth2 flow needs a browser and cannot be driven
#                  from a script.
#
# Auth setup (once, and it needs a browser -- the `colaboratory` scope is the
# one that is easy to miss, and without it `colab new` unassigns the VM):
#
#   gcloud auth application-default login --scopes=openid,\
#   https://www.googleapis.com/auth/cloud-platform,\
#   https://www.googleapis.com/auth/userinfo.email,\
#   https://www.googleapis.com/auth/colaboratory
#
# Check with: scripts/colab whoami
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/venv/bin/python"
# Isolated uv tool install, NOT the project venv: colab-cli 0.6.0 calls
# jupyter_kernel_client.KernelClient, which was renamed in 1.0.0, and the venv
# resolves that package to 1.0.2 for ipykernel. Pinning 0.15.0 in a separate
# environment keeps both working.
CLI="${COLAB_CLI:-$HOME/.local/bin/colab}"

if [[ ! -x "$CLI" ]]; then
  cat >&2 <<'MSG'
colab CLI not installed. Install it isolated, with the pin it needs:

  uv tool install google-colab-cli --with "jupyter-kernel-client==0.15.0"

MSG
  exit 1
fi

export SSL_CERT_FILE="${SSL_CERT_FILE:-$("$PY" -c 'import certifi; print(certifi.where())')}"
export REQUESTS_CA_BUNDLE="${REQUESTS_CA_BUNDLE:-$SSL_CERT_FILE}"

exec "$CLI" --auth=adc "$@"
